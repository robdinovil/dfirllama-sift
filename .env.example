# DFIRLlama-SIFT — environment configuration
# Copy to .env and adjust values

# LLM backend: "auto" | "claude-cli" | "claude-api" | "ollama"
# "auto" tries claude-cli first, then claude-api, then ollama
LLM_BACKEND=auto

# Required only if LLM_BACKEND=claude-api
ANTHROPIC_API_KEY=sk-ant-...

# Required only if LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=mistral:7b

# Evidence root — agent is read-only restricted to this path
EVIDENCE_ROOT=/cases

# Structured audit trail (JSONL)
AUDIT_LOG=/tmp/dfirllama_audit.log
