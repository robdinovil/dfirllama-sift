# DFIRLlama-SIFT — configuración de entorno
# Copiar a .env y ajustar valores

# LLM backend: "claude" | "ollama"
LLM_BACKEND=claude

# Si LLM_BACKEND=claude
ANTHROPIC_API_KEY=sk-ant-...

# Si LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=mistral:7b

# Directorio de evidencia (read-only guardrail)
EVIDENCE_ROOT=/cases

# Audit trail
AUDIT_LOG=/tmp/dfirllama_audit.log
